{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "goldenboy-productions.vercel.app"
        }
      ],
      "destination": "https://www.robertlazau.com/:path*",
      "permanent": true
    },
    {
      "source": "/behind-the-scenes",
      "destination": "/recaps",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
