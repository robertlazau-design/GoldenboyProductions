{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "goldenboy-productions.vercel.app"
        }
      ],
      "destination": "https://www.robertlazau.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "goldenboy-productions.vercel.app"
        }
      ],
      "destination": "https://www.robertlazau.com/:path*",
      "permanent": true
    },
    {
      "source": "/favorite-movies",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/recaps",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/recaps/:path*",
      "destination": "/work",
      "permanent": false
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
